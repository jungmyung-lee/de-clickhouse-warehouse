# Copy this file to .env and fill in the values. Never commit .env.
# Placeholders only. No real secrets here.

# --- ClickHouse (the warehouse) ---
CLICKHOUSE_DB=bronze
CLICKHOUSE_USER=your_clickhouse_user
CLICKHOUSE_PASSWORD=your_clickhouse_password

# --- Airflow ---
# macOS: 501 is usually right. Linux: run `id -u`.
AIRFLOW_UID=501
# Generate with:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=your_fernet_key_here
# Airflow web login
_AIRFLOW_WWW_USER_USERNAME=your_airflow_user
_AIRFLOW_WWW_USER_PASSWORD=your_airflow_password
